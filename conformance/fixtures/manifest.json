    },
    {
      "file": "tampered-seq.json",
      "expect_status": "BROKEN",
      "expect_reason": "SEQ_INVALID"
    },
    {
      "file": "tampered-duplicate-source.json",
      "expect_status": "BROKEN",
      "expect_reason": "DUPLICATE_SOURCE"
    },
    {
      "file": "tampered-forged-tip.json",
      "expect_status": "BROKEN",
